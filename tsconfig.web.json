{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "useDefineForClassFields": true,
    "allowJs": false,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@": ["./src/web"],
      "@/*": ["./src/web/*"],
      "@nav": ["./src/web"],
      "@nav/*": ["./src/web/*"],
      "@shared": ["./src/shared/index.ts"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "src/web/vite-env.d.ts"]
}
