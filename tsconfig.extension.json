{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "useDefineForClassFields": true,
    "allowJs": false,
    "jsx": "react-jsx",
    "types": ["vite/client", "chrome"],
    "paths": {
      "@ext": ["./src/extension"],
      "@ext/*": ["./src/extension/*"],
      "@shared": ["./src/shared/index.ts"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/extension/**/*.ts", "src/extension/**/*.tsx", "src/extension/**/*.css"]
}
