{
  "name": "cf-workers-nav",
  "version": "0.3.0",
  "private": true,
  "description": "Cloudflare Workers bookmark service and Chrome extension",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:extension",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "bundle:extension": "pnpm run build:extension && node scripts/pack-extension.mjs",
    "cf-typegen": "wrangler types",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nav --local --persist-to ./.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply nav --remote",
    "deploy": "pnpm run build:web && wrangler deploy",
    "dev": "pnpm run build:web && concurrently --kill-others --names worker,web \"pnpm run dev:worker\" \"pnpm run watch:web\"",
    "dev:worker": "wrangler dev --port 8787 --inspector-port 9229 --persist-to ./.wrangler/state",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "pnpm run test:unit && pnpm run test:worker",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "pnpm run typecheck:shared && pnpm run typecheck:worker && pnpm run typecheck:web && pnpm run typecheck:extension",
    "typecheck:extension": "tsc -p tsconfig.extension.json --noEmit",
    "typecheck:shared": "tsc -p tsconfig.shared.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "watch:extension": "vite build --config vite.extension.config.ts --watch",
    "watch:web": "vite build --config vite.web.config.ts --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/geist-mono": "5.2.8",
    "@tanstack/react-router": "^1.170.31",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.27",
    "lucide-react": "1.25.0",
    "motion": "12.41.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@cloudflare/vitest-pool-workers": "0.16.19",
    "@cloudflare/workers-types": "4.20260624.1",
    "@crxjs/vite-plugin": "^2.7.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@types/babel__core": "^7.20.5",
    "@types/chrome": "^0.2.0",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "0.31.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.0",
    "wrangler": "4.104.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.22.0"
}
